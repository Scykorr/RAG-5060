# Copy to .env inside WSL project mount; never commit secrets.

POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg://rag:change-me@postgres:5432/rag

VALKEY_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks_v1

OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NO_CLOUD=1

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

SESSION_SECRET=change-me-long-random
ADMIN_LOGIN=admin
# Default local credentials; change anytime in UI (Settings).
ADMIN_PASSWORD=admin

UPLOAD_MAX_MB=25
MODEL_IMPORT_MAX_GB=20
WSL_MEMORY_GB=20

# Heavy data inside containers (Docker volume by default).
DATA_ROOT=/var/lib/rag
# Optional host hint for launcher / portable installs (not required when using named volumes).
# RAG_DATA_ROOT=D:/RAG5060/data

COMPOSE_PROFILE=core
OFFLINE_MODE=true
# Host UI port (mapped to nginx:8080). Default 18080 avoids clashes with other :8080 apps.
RAG_UI_PORT=18080

# Document graph (MVP defaults live in apps/api/services/graph/settings.py)
# GRAPH_ENABLED=true
# GRAPH_LLM_ANALYSIS_ENABLED=false
# GRAPH_LEXICAL_MIN_SCORE=0.22
# GRAPH_BUILD_CONCURRENCY=1

# Bulk import folder (host path mounted into API container)
IMPORT_INBOX=/var/lib/rag/inbox
IMPORT_INBOX_HOST=/mnt/d/RAG5060/inbox
IMPORT_INBOX_HOST_HINT=D:\RAG5060\inbox
